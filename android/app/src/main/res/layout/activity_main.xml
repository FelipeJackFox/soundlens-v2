<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <com.google.android.material.textfield.MaterialAutoCompleteTextView
        android:id="@+id/dropExamples"
        android:layout_width="128dp"
        android:layout_height="36dp"
        android:background="@drawable/dropdown_chip"
        android:paddingStart="10dp"
        android:paddingEnd="32dp"
        android:gravity="center_vertical"
        android:text="EXAMPLES"
        android:textStyle="bold"
        android:textSize="12sp"
        android:textColor="@android:color/black"
        android:inputType="none"
        android:focusable="true"
        android:clickable="true"
        android:cursorVisible="false"
        android:drawableEnd="@drawable/ic_arrow_drop_down"
        android:dropDownVerticalOffset="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <FrameLayout
        android:id="@+id/mainCircle"
        android:layout_width="230dp"
        android:layout_height="230dp"
        android:background="@drawable/main_circle"
        app:layout_constraintTop_toBottomOf="@id/dropExamples"
        app:layout_constraintBottom_toTopOf="@id/btnSend"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.45">

        <ImageView
            android:id="@+id/imgMainIcon"
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:layout_gravity="center"
            android:contentDescription="SoundLens logo"
            android:scaleType="centerInside"
            android:src="@drawable/soundlens_logo" />

        <ImageView
            android:id="@+id/btnTrash"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="6dp"
            android:background="@drawable/trash_circle"
            android:padding="10dp"
            android:src="@drawable/ic_trash"
            android:visibility="gone"/>
    </FrameLayout>

    <TextView
        android:id="@+id/txtRecordTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00"
        android:visibility="gone"
        android:paddingTop="8dp"
        android:textStyle="bold"
        android:textSize="20sp"
        android:textColor="@color/sl_green"
        app:layout_constraintTop_toBottomOf="@id/mainCircle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/playerBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/txtRecordTimer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txtElapsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:textColor="@android:color/white"
            android:paddingEnd="8dp"/>

        <SeekBar
            android:id="@+id/seek"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/txtRemaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-0:00"
            android:textColor="@android:color/white"
            android:paddingStart="8dp"/>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSend"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:text="SEND"
        android:textStyle="bold"
        android:textColor="@color/sl_green"
        android:backgroundTint="@color/sl_card"
        app:cornerRadius="26dp"
        app:layout_constraintTop_toBottomOf="@id/playerBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
